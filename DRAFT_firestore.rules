rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOrPasswordAccount() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isOwner(userId) {
      return isVerifiedOrPasswordAccount() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function parentUserExistsAndOwned(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap & Volumetric Constraints)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferredLanguage',
          'preferredTheme',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferredLanguage',
          'preferredTheme',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.photoURL is string &&
        data.photoURL.size() >= 0 &&
        data.photoURL.size() <= 1024 &&
        data.preferredLanguage is string &&
        data.preferredLanguage.size() == 2 &&
        (data.preferredLanguage == 'en' || data.preferredLanguage == 'te') &&
        data.preferredTheme is string &&
        data.preferredTheme.size() >= 4 &&
        data.preferredTheme.size() <= 5 &&
        (data.preferredTheme == 'light' || data.preferredTheme == 'dark' || data.preferredTheme == 'neon') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedBloodReport(data) {
      return data.keys().hasAll([
          'userId',
          'patientName',
          'labName',
          'reportDate',
          'overallWellnessScore',
          'needsAttentionCount',
          'normalCount',
          'totalTestsCount',
          'keyFindingsEn',
          'keyFindingsTe',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'patientName',
          'labName',
          'reportDate',
          'overallWellnessScore',
          'needsAttentionCount',
          'normalCount',
          'totalTestsCount',
          'keyFindingsEn',
          'keyFindingsTe',
          'createdAt'
        ]) &&
        data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.patientName is string &&
        data.patientName.size() >= 1 &&
        data.patientName.size() <= 120 &&
        data.labName is string &&
        data.labName.size() >= 1 &&
        data.labName.size() <= 160 &&
        data.reportDate is string &&
        data.reportDate.size() >= 1 &&
        data.reportDate.size() <= 80 &&
        data.overallWellnessScore is number &&
        data.overallWellnessScore >= 0 &&
        data.overallWellnessScore <= 100 &&
        data.needsAttentionCount is number &&
        data.needsAttentionCount >= 0 &&
        data.needsAttentionCount <= 200 &&
        data.normalCount is number &&
        data.normalCount >= 0 &&
        data.normalCount <= 200 &&
        data.totalTestsCount is number &&
        data.totalTestsCount >= 1 &&
        data.totalTestsCount <= 200 &&
        data.keyFindingsEn is string &&
        data.keyFindingsEn.size() >= 1 &&
        data.keyFindingsEn.size() <= 2000 &&
        data.keyFindingsTe is string &&
        data.keyFindingsTe.size() >= 1 &&
        data.keyFindingsTe.size() <= 2000 &&
        data.createdAt is timestamp;
    }

    function isValidSavedPlateScan(data) {
      return data.keys().hasAll([
          'userId',
          'verdictTitleEn',
          'verdictTitleTe',
          'plateScore',
          'plateGrade',
          'totalCalories',
          'totalCarbsG',
          'totalProteinG',
          'totalFiberG',
          'avgGlycemicIndex',
          'dishesSummaryEn',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'verdictTitleEn',
          'verdictTitleTe',
          'plateScore',
          'plateGrade',
          'totalCalories',
          'totalCarbsG',
          'totalProteinG',
          'totalFiberG',
          'avgGlycemicIndex',
          'dishesSummaryEn',
          'createdAt'
        ]) &&
        data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.verdictTitleEn is string &&
        data.verdictTitleEn.size() >= 1 &&
        data.verdictTitleEn.size() <= 200 &&
        data.verdictTitleTe is string &&
        data.verdictTitleTe.size() >= 1 &&
        data.verdictTitleTe.size() <= 200 &&
        data.plateScore is number &&
        data.plateScore >= 0 &&
        data.plateScore <= 100 &&
        data.plateGrade is string &&
        data.plateGrade.size() >= 3 &&
        data.plateGrade.size() <= 16 &&
        (data.plateGrade == 'Green' || data.plateGrade == 'Yellow' || data.plateGrade == 'Red') &&
        data.totalCalories is number &&
        data.totalCalories >= 0 &&
        data.totalCalories <= 5000 &&
        data.totalCarbsG is number &&
        data.totalCarbsG >= 0 &&
        data.totalCarbsG <= 1000 &&
        data.totalProteinG is number &&
        data.totalProteinG >= 0 &&
        data.totalProteinG <= 500 &&
        data.totalFiberG is number &&
        data.totalFiberG >= 0 &&
        data.totalFiberG <= 500 &&
        data.avgGlycemicIndex is number &&
        data.avgGlycemicIndex >= 0 &&
        data.avgGlycemicIndex <= 150 &&
        data.dishesSummaryEn is string &&
        data.dishesSummaryEn.size() >= 1 &&
        data.dishesSummaryEn.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /users/{userId} (PII Isolated to Owner Only)
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'preferredLanguage',
            'preferredTheme',
            'updatedAt'
          ])
        );

      allow delete: if false;

      // =======================================================================
      // Subcollection 2: /users/{userId}/reports/{reportId}
      // =======================================================================
      match /reports/{reportId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(reportId) &&
          existing().userId == request.auth.uid &&
          parentUserExistsAndOwned(userId);

        allow list: if isOwner(userId) &&
          existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(reportId) &&
          isValidSavedBloodReport(incoming()) &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          parentUserExistsAndOwned(userId);

        allow update: if false;

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(reportId) &&
          existing().userId == request.auth.uid &&
          parentUserExistsAndOwned(userId);
      }

      // =======================================================================
      // Subcollection 3: /users/{userId}/plates/{plateId}
      // =======================================================================
      match /plates/{plateId} {
        allow get: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(plateId) &&
          existing().userId == request.auth.uid &&
          parentUserExistsAndOwned(userId);

        allow list: if isOwner(userId) &&
          existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(plateId) &&
          isValidSavedPlateScan(incoming()) &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          parentUserExistsAndOwned(userId);

        allow update: if false;

        allow delete: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(plateId) &&
          existing().userId == request.auth.uid &&
          parentUserExistsAndOwned(userId);
      }
    }
  }
}
