{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated patient profile and accessibility preferences isolated to the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the signed-in patient.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address of the user.",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL from Google Sign-In.",
          "minLength": 0,
          "maxLength": 1024
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Preferred UI & voice readout language.",
          "enum": ["en", "te"],
          "minLength": 2,
          "maxLength": 2
        },
        "preferredTheme": {
          "type": "string",
          "description": "Preferred visual theme mode.",
          "enum": ["light", "dark", "neon"],
          "minLength": 4,
          "maxLength": 5
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "preferredLanguage",
        "preferredTheme",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedBloodReport": {
      "title": "SavedBloodReport",
      "description": "Historical blood test report analysis summary belonging to a signed-in user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "description": "Patient name extracted from the blood report.",
          "minLength": 1,
          "maxLength": 120
        },
        "labName": {
          "type": "string",
          "description": "Laboratory name extracted from the blood report.",
          "minLength": 1,
          "maxLength": 160
        },
        "reportDate": {
          "type": "string",
          "description": "Report date printed on the lab report.",
          "minLength": 1,
          "maxLength": 80
        },
        "overallWellnessScore": {
          "type": "number",
          "description": "Machine learning wellness index (0-100)."
        },
        "needsAttentionCount": {
          "type": "number",
          "description": "Number of out-of-range blood tests."
        },
        "normalCount": {
          "type": "number",
          "description": "Number of normal blood tests."
        },
        "totalTestsCount": {
          "type": "number",
          "description": "Total number of extracted blood tests."
        },
        "keyFindingsEn": {
          "type": "string",
          "description": "Concise English summary of extracted findings.",
          "minLength": 1,
          "maxLength": 2000
        },
        "keyFindingsTe": {
          "type": "string",
          "description": "Concise Telugu summary of extracted findings.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the report record was saved."
        }
      },
      "required": [
        "userId",
        "patientName",
        "labName",
        "reportDate",
        "overallWellnessScore",
        "needsAttentionCount",
        "normalCount",
        "totalTestsCount",
        "keyFindingsEn",
        "keyFindingsTe",
        "createdAt"
      ]
    },
    "SavedPlateScan": {
      "title": "SavedPlateScan",
      "description": "Analyze My Plate camera meal scan record belonging to a signed-in user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "verdictTitleEn": {
          "type": "string",
          "description": "English plate verdict heading.",
          "minLength": 1,
          "maxLength": 200
        },
        "verdictTitleTe": {
          "type": "string",
          "description": "Telugu plate verdict heading.",
          "minLength": 1,
          "maxLength": 200
        },
        "plateScore": {
          "type": "number",
          "description": "Plate nutrition score (0-100)."
        },
        "plateGrade": {
          "type": "string",
          "description": "Traffic light grade of the plate.",
          "enum": ["Green", "Yellow", "Red"],
          "minLength": 3,
          "maxLength": 16
        },
        "totalCalories": {
          "type": "number",
          "description": "Estimated total calories (kcal)."
        },
        "totalCarbsG": {
          "type": "number",
          "description": "Estimated total carbohydrates in grams."
        },
        "totalProteinG": {
          "type": "number",
          "description": "Estimated total protein in grams."
        },
        "totalFiberG": {
          "type": "number",
          "description": "Estimated total dietary fiber in grams."
        },
        "avgGlycemicIndex": {
          "type": "number",
          "description": "Weighted average glycemic index (0-150)."
        },
        "dishesSummaryEn": {
          "type": "string",
          "description": "Comma-separated summary of detected dishes on the plate.",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the plate scan was saved."
        }
      },
      "required": [
        "userId",
        "verdictTitleEn",
        "verdictTitleTe",
        "plateScore",
        "plateGrade",
        "totalCalories",
        "totalCarbsG",
        "totalProteinG",
        "totalFiberG",
        "avgGlycemicIndex",
        "dishesSummaryEn",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores private patient profile and theme/language preferences for each authenticated user."
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/SavedBloodReport" },
      "description": "Stores analyzed blood test report summaries for the authenticated user."
    },
    "/users/{userId}/plates/{plateId}": {
      "schema": { "$ref": "#/entities/SavedPlateScan" },
      "description": "Stores Analyze My Plate camera meal evaluations for the authenticated user."
    }
  }
}
